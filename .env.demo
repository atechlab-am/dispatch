POSTGRES_DB=dispatch
POSTGRES_USER=dispatch
POSTGRES_PASSWORD=dispatch_demo_password
SECRET_KEY=dispatch_demo_secret_key_do_not_use_in_production_00000000

# Port the client portal service listens on (default: 8080).
PORTAL_PORT=8080

# This is a demo/local-eval config — SECRET_KEY and POSTGRES_PASSWORD above are
# NOT secret and must never be used for a real deployment. For anything beyond
# local evaluation, run scripts/linux/install.sh or scripts/windows/install.ps1,
# which generate a real .env with random secrets instead of copying this file.

POSTGRES_DB=dispatch
POSTGRES_USER=dispatch
POSTGRES_PASSWORD=dispatch_demo_password
SECRET_KEY=8a0e80ffbd97205097560c20fbca58382c29ca32ec618c8b67b0c88641bf95b8

# Port the client portal service listens on (default: 8080).
# Point your Cloudflare tunnel to this port — it only serves /p/* and /api/portal/*.
# The staff app stays on port 80 and should NOT be exposed to Cloudflare.
PORTAL_PORT=8080

# File uploads — path inside the container (volume-mounted in docker-compose.yml)
# UPLOAD_DIR=/app/uploads

# GitHub update notifications — optional
# Create a PAT at https://github.com/settings/tokens with "repo" read scope
#GITHUB_REPO=yourorg/dispatch
#GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ATech Solutions suite switcher — optional. Set any of these to show a
# switcher icon in the topbar linking out to that app. Plain links only (no
# shared login) — each app's own sign-in page opens in a new tab.
#SUITE_PULSE_URL=https://pulse.yourdomain.com
#SUITE_TETHER_URL=https://tether.yourdomain.com
#SUITE_FOLIO_URL=https://folio.yourdomain.com
#SUITE_FORGE_URL=https://forge.yourdomain.com
#SUITE_PASSVAULT_URL=https://passvault.yourdomain.com
#SUITE_SCOUT_URL=https://scout.yourdomain.com

# SMTP — optional; leave SMTP_HOST blank to disable email notifications
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=you@gmail.com
#SMTP_PASSWORD=your-app-password
#SMTP_FROM=dispatch@atechsolutions.org
#SMTP_TLS=true

# Stripe — optional; leave all three blank to disable online payments (the portal's
# "Pay Now" button will show a "coming soon" message instead of failing).
# Get these from the Stripe dashboard: Developers > API keys / Developers > Webhooks.
# The webhook endpoint (/api/payments/webhook) is proxied through nginx.portal.conf,
# since that's the only internet-facing nginx config in this deployment — see setup.md
# if you're upgrading an existing deployment and need to add that location block.
#STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
#STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
#STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Public base URL of the client portal (no trailing slash) — used to build the
# Stripe Checkout success/cancel redirect URLs. Only needed if Stripe is configured.
#PORTAL_URL=https://portal.yourdomain.com

# Inbound email (email-to-ticket) — optional; if unset, the inbound webhook
# always rejects with 404. Set to a long random value and put it in the
# webhook URL configured in your inbound email provider (e.g. Postmark).
#INBOUND_EMAIL_SECRET=your-long-random-secret

# Backups to NAS — optional; leave BACKUP_NAS_HOST blank to disable entirely
# (the scheduled backup loop silently skips every cycle, and "Backup Now" in
# Settings > Backup will fail with a clear error). Pushed directly over SMB2/3
# — no CIFS mount on the host or in the container is needed.
#BACKUP_NAS_HOST=192.168.1.50
#BACKUP_NAS_SHARE=backups
#BACKUP_NAS_PATH=dispatch-backups
#BACKUP_NAS_USERNAME=dispatch-backup
#BACKUP_NAS_PASSWORD=your-nas-password
# Only needed if your NAS/AD setup requires a domain for SMB auth
#BACKUP_NAS_DOMAIN=
# How often the scheduled backup runs, in hours (default: 24 = once daily)
#BACKUP_INTERVAL_HOURS=24
# How many backups to keep on the NAS share before pruning the oldest (default: 14)
#BACKUP_RETENTION_COUNT=14

# Feature toggles — all optional, default enabled. Set any to "false" to turn
# that feature off (its API returns 503, its background loop if any stops
# starting, and its nav/tab disappears from the UI). Uncomment only the ones
# you want to disable.
#FEATURE_AUDIT_LOG=true
#FEATURE_TIMER=true
#FEATURE_AR_AGING=true
#FEATURE_NOTIFICATIONS=true
#FEATURE_RECURRING_INVOICING=true
#FEATURE_SCHEDULING=true
#FEATURE_QUOTES=true
#FEATURE_GLOBAL_SEARCH=true
#FEATURE_CANNED_RESPONSES=true
#FEATURE_SLA_ESCALATION=true
#FEATURE_SLA_TIERS=true
#FEATURE_MATERIALS=true
#FEATURE_BACKUPS=true

# Two-factor auth (2FA) — unlike every toggle above, this one defaults to
# DISABLED. It changes the login flow itself (adds a second step for accounts
# that enroll), so set it to "true" explicitly to allow staff to turn on 2FA
# in Settings > Security.
#FEATURE_2FA=false
